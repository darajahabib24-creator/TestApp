{
  "name": "minicode-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight open-source VS Code-style IDE (Electron + TypeScript + Monaco)",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && cross-env MINICODE_DEV_URL=http://localhost:5173 electron .",
    "dev": "npm-run-all --parallel dev:renderer dev:main"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cross-env": "^7.0.3",
    "electron": "^45.2.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
