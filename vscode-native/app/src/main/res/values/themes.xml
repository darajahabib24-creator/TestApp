<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MiniCode" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vs_dark</item>
        <item name="android:statusBarColor">@color/vs_dark</item>
        <item name="android:navigationBarColor">@color/vs_panel</item>
        <item name="android:colorPrimary">@color/vs_accent</item>
        <item name="android:textColorPrimary">@color/vs_text</item>
    </style>
    <style name="Theme.MiniCode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vs_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_minicode</item>
        <item name="postSplashScreenTheme">@style/Theme.MiniCode</item>
    </style>
</resources>
